# @seer-pm/sdk peer-depends on @wagmi/core >=2.0.0, which npm tries to satisfy with the 3.x
# line; wagmi 2.x here needs 2.20.3. Both majors legitimately coexist in the tree (Reown's
# adapter pulls the 3.x one), so let npm nest them instead of failing the resolution.
legacy-peer-deps=true

# The catch: this also turns off npm's automatic *installation* of peer dependencies (npm 6
# behaviour). Any peer a package genuinely imports at runtime must therefore be listed in our own
# `dependencies`, or it silently never lands in node_modules and the code only fails when the
# import runs. That is what took the market-data functions down: `@apollo/client` imports `rxjs`
# from ApolloClient.js, adding this file dropped rxjs from the lockfile, and every Apollo-importing
# Netlify function started returning 502 ERR_MODULE_NOT_FOUND. `rxjs` is now a direct dependency.
