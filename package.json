{
  "name": "ai-prediction-markets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run codegen && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "export:l1-pnl": "esbuild scripts/exportL1Pnl.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=scripts/.exportL1Pnl.mjs --log-level=warning && node scripts/.exportL1Pnl.mjs",
    "export:l2-pnl": "esbuild scripts/exportL2Pnl.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=scripts/.exportL2Pnl.mjs --log-level=warning && node --env-file=.env scripts/.exportL2Pnl.mjs",
    "rebuild:chart-series": "esbuild scripts/rebuildChartSeries.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=scripts/.rebuildChartSeries.mjs --log-level=warning && node --env-file=.env scripts/.rebuildChartSeries.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.0.4",
    "@netlify/functions": "^4.2.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reown/appkit": "^1.8.4",
    "@reown/appkit-adapter-wagmi": "^1.8.4",
    "@seer-pm/react": "^0.0.9",
    "@seer-pm/sdk": "^0.0.18",
    "@supabase/supabase-js": "^2.57.4",
    "@swapr/sdk": "https://github.com/seer-pm/swapr-sdk#4a521db50bcdfafc89ef838356791e02ebc609cd",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/query-async-storage-persister": "^5.87.4",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-persist-client": "^5.87.4",
    "@uniswap/v3-sdk": "^3.25.2",
    "date-fns": "^4.1.0",
    "graphql": "^16.11.0",
    "graphql-combine-query": "https://github.com/xyzseer/graphql-combine-query#ab552af27b3badb975f7dcad88b140bdb017a6fe",
    "idb-keyval": "^6.3.0",
    "lightweight-charts": "^5.1.0",
    "p-limit": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-paginate": "^8.3.0",
    "react-toastify": "^11.0.5",
    "rxjs": "^7.8.2",
    "viem": "^2.37.5",
    "wagmi": "^2.16.9",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/client-preset": "5.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
